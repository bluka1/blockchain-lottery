# Network RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private Keys (NEVER commit actual private keys!)
SEPOLIA_PRIVATE_KEY=your_private_key_here
MAINNET_PRIVATE_KEY=your_private_key_here

# Chainlink VRF Subscription IDs
# Create subscriptions at: https://vrf.chain.link
SEPOLIA_VRF_SUBSCRIPTION_ID=0
MAINNET_VRF_SUBSCRIPTION_ID=0

# Optional VRF overrides (defaults to official Sepolia values)
SEPOLIA_VRF_COORDINATOR=
SEPOLIA_KEY_HASH=

# Chainlink Automation forwarder/registry allowed to call performUpkeep
# Optional: if set, deploy script calls setAutomationRegistry automatically
AUTOMATION_REGISTRY=

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
